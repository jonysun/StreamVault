{
  "name": "StreamVault Native Video",
  "id": "StreamVault-NativeVideo",
  "version": "0.1.0",
  "description": "Native Android immersive video feed for StreamVault.",
  "_dp_type": "nativeplugin",
  "_dp_nativeplugin": {
    "android": {
      "integrateType": "aar",
      "dependencies": [
        "androidx.appcompat:appcompat:1.7.0",
        "androidx.recyclerview:recyclerview:1.3.2",
        "androidx.viewpager2:viewpager2:1.1.0",
        "androidx.media3:media3-exoplayer:1.4.1",
        "androidx.media3:media3-exoplayer-hls:1.4.1",
        "androidx.media3:media3-ui:1.4.1",
        "androidx.media3:media3-datasource:1.4.1",
        "androidx.media3:media3-datasource-okhttp:1.4.1",
        "com.squareup.okhttp3:okhttp:4.12.0",
        "com.github.bumptech.glide:glide:4.16.0",
        "com.alibaba:fastjson:1.2.83"
      ],
      "plugins": [
        {
          "type": "module",
          "name": "StreamVault-NativeVideo",
          "class": "com.streamvault.nativefeed.StreamVaultNativeVideoModule"
        }
      ],
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "compileOptions": {
        "sourceCompatibility": "1.8",
        "targetCompatibility": "1.8"
      },
      "minSdkVersion": 23,
      "useAndroidX": true
    }
  }
}

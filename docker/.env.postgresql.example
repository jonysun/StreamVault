SPRING_PROFILES_ACTIVE=docker,postgresql
COMPOSE_PROFILES=postgresql
STREAMVAULT_IMAGE=jonysun/stream-vault:v5.7.1
STREAMVAULT_DB_NAME=streamvault
STREAMVAULT_DB_USER=streamvault
STREAMVAULT_DB_PASSWORD=replace-with-a-long-random-password
STREAMVAULT_DB_URL=jdbc:postgresql://postgres:5432/streamvault
STREAMVAULT_MIGRATION_MODE=dry-run
STREAMVAULT_MIGRATION_BATCH_SIZE=500
# Set to LOAD only for the explicit load step.
STREAMVAULT_MIGRATION_CONFIRM=
